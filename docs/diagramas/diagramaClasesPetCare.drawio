<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="AUpSO0Rw4OhgTWB591rs">
    <mxGraphModel dx="4746" dy="1679" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml PetCare\n\n&#39; ===================== CONFIGURACIÓN GENERAL =====================\nleft to right direction\n\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam packageStyle rectangle\nskinparam nodesep 45\nskinparam ranksep 55\nskinparam shadowing false\n\nhide empty members\n\n&#39; ===================== org.petcare.util =====================\npackage \&quot;org.petcare.util\&quot; {\n  interface Validatable {\n    + validateData(): void\n  }\n}\n\n&#39; ===================== org.petcare.model.person =====================\npackage \&quot;org.petcare.model.person\&quot; {\n\n  abstract class Person {\n    - id: int\n    - firstName: String\n    - lastName: String\n    - phone: String\n    - email: String\n    + getId(): int\n    + setId(id: int): void\n    + getFirstName(): String\n    + setFirstName(firstName: String): void\n    + getLastName(): String\n    + setLastName(lastName: String): void\n    + getPhone(): String\n    + setPhone(phone: String): void\n    + getEmail(): String\n    + setEmail(email: String): void\n  }\n\n  class Client {\n    - address: String\n    + registerPet(pet: Pet): void\n    + getAddress(): String\n    + setAddress(address: String): void\n  }\n\n  abstract class Employee {\n    - employeeId: int\n    - baseSalary: double\n    + validateData(): void\n    + getEmployeeId(): int\n    + getRole(): EmployeeRole\n    + getBaseSalary(): double\n    + setBaseSalary(baseSalary: double): void\n  }\n\n  class Veterinarian {\n    - medicalLicense: String\n    - specialty: String\n    + getMedicalLicense(): String\n    + setMedicalLicense(medicalLicense: String): void\n    + getSpecialty(): String\n    + setSpecialty(specialty: String): void\n  }\n\n  class Receptionist {\n    - assignedShift: ShiftType\n    + getAssignedShift(): ShiftType\n    + setAssignedShift(assignedShift: ShiftType): void\n  }\n\n  enum EmployeeRole {\n    ADMINISTRATOR\n    RECEPTIONIST\n    VETERINARIAN\n  }\n\n  enum ShiftType {\n    MORNING\n    EVENING\n    NIGHT\n  }\n}\n\n&#39; ===================== org.petcare.model.pet =====================\npackage \&quot;org.petcare.model.pet\&quot; {\n\n  abstract class Pet {\n    - id: int\n    - name: String\n    - age: int\n    - weight: double\n    + {abstract} makeSound(): void\n    + validateData(): void\n    + getId(): int\n    + getName(): String\n    + getAge(): int\n    + getWeight(): double\n    + getOwner(): Client\n    + getHistory(): MedicalHistory\n  }\n\n  class Dog {\n    - breed: String\n    + makeSound(): void\n  }\n\n  class Cat {\n    - isDomestic: boolean\n    + makeSound(): void\n  }\n\n  class ExoticBird {\n    - wingSpan: double\n    + makeSound(): void\n  }\n}\n\n&#39; ===================== org.petcare.model.service =====================\npackage \&quot;org.petcare.model.service\&quot; {\n\n  abstract class Service {\n    - name: String\n    + {abstract} calculateCost(): double\n    + validateData(): void\n    + getName(): String\n  }\n\n  class GeneralConsultation {\n    - baseFee: double\n    + calculateCost(): double\n  }\n\n  class Vaccination {\n    - baseFee: double\n    + calculateCost(): double\n  }\n\n  class Surgery {\n    - hours: double\n    + calculateCost(): double\n  }\n\n  enum VaccineType {\n    RABIES\n    PARVOVIRUS\n    - cost: double\n  }\n\n  enum SurgeryComplexity {\n    LOW\n    MEDIUM\n    HIGH\n    - riskMultiplier: double\n  }\n}\n\n&#39; ===================== org.petcare.model.clinic =====================\npackage \&quot;org.petcare.model.clinic\&quot; {\n\n  class Clinic {\n    - name: String\n    - address: String\n    + addEmployee(employee: Employee): void\n    + addRoom(room: ConsultingRoom): void\n  }\n\n  class ConsultingRoom {\n    - roomNumber: String\n    + isAvailable(dateTime: LocalDateTime): boolean\n  }\n\n  class Appointment {\n    - dateTime: LocalDateTime\n    + attend(): Receipt\n    + cancel(): void\n  }\n\n  class MedicalHistory {\n    - appointments: TreeSet&lt;Appointment&gt;\n    + addRecord(appointment: Appointment): void\n    + getLastVisit(): Appointment\n  }\n\n  class Receipt {\n    - totalAmount: double\n    - issueDate: LocalDate\n    + generateTicket(): void\n  }\n\n  enum AppointmentStatus {\n    SCHEDULED\n    CANCELED\n    COMPLETED\n  }\n}\n\n&#39; ===================== org.petcare.controller =====================\npackage \&quot;org.petcare.controller\&quot; {\n\n  class ClinicController {\n    - clientPets: HashMap&lt;Client, List&lt;Pet&gt;&gt;\n    - waitingRoom: Queue&lt;Pet&gt;\n    + scheduleAppointment(...): Appointment\n    + calculateVetIncome(vet: Veterinarian): double\n  }\n}\n\n&#39; ===================== org.petcare.view =====================\npackage \&quot;org.petcare.view\&quot; {\n\n  interface Menu {\n    + displayOptions(): void\n    + readUserInput(): int\n  }\n\n  class AdminMenu {\n    - controller: ClinicController\n    - scanner: Scanner\n    + displayOptions(): void\n    + readUserInput(): int\n  }\n\n  class ReceptionistMenu {\n    - controller: ClinicController\n    - scanner: Scanner\n    + displayOptions(): void\n    + readUserInput(): int\n  }\n}\n\n&#39; ============================================================\n&#39;                     RELACIONES UML\n&#39; ============================================================\n\n&#39; ===================== HERENCIA =====================\n\nPerson &lt;|-- Client\nPerson &lt;|-- Employee\nEmployee &lt;|-- Veterinarian\nEmployee &lt;|-- Receptionist\n\nPet &lt;|-- Dog\nPet &lt;|-- Cat\nPet &lt;|-- ExoticBird\n\nService &lt;|-- GeneralConsultation\nService &lt;|-- Vaccination\nService &lt;|-- Surgery\n\n&#39; ===================== IMPLEMENTACIÓN =====================\n\nValidatable &lt;|.. Employee\nValidatable &lt;|.. Pet\nValidatable &lt;|.. Service\n\nMenu &lt;|.. AdminMenu\nMenu &lt;|.. ReceptionistMenu\n\n&#39; ===================== ASOCIACIONES CON ENUMS =====================\n\nEmployee --&gt; EmployeeRole : role\nReceptionist --&gt; ShiftType : assignedShift\nVaccination --&gt; VaccineType : vaccineType\nSurgery --&gt; SurgeryComplexity : complexityLevel\nAppointment --&gt; AppointmentStatus : status\n\n&#39; ===================== COMPOSICIÓN =====================\n\nPet *-- \&quot;1\&quot; MedicalHistory : history\nClinic *-- \&quot;1..*\&quot; ConsultingRoom : rooms\n\n&#39; ===================== AGREGACIÓN =====================\n\nClinic o-- \&quot;0..*\&quot; Employee : employees\nAppointment o-- \&quot;1\&quot; Pet : patient\nAppointment o-- \&quot;1\&quot; Veterinarian : vet\nAppointment o-- \&quot;1\&quot; ConsultingRoom : room\nAppointment o-- \&quot;1..*\&quot; Service : services\nMedicalHistory o-- \&quot;0..*\&quot; Appointment : appointments\n\nClinicController o-- \&quot;0..*\&quot; Client\nClinicController o-- \&quot;0..*\&quot; Pet\n\n&#39; ===================== ASOCIACIÓN =====================\n\nPet \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Client : owner\n\n&#39; ===================== DEPENDENCIAS =====================\n\nAppointment ..&gt; Receipt : &lt;&lt;create&gt;&gt;\nClinicController ..&gt; Appointment : &lt;&lt;use&gt;&gt;\nClinicController ..&gt; Clinic : &lt;&lt;use&gt;&gt;\n\nAdminMenu --&gt; ClinicController : controller\nReceptionistMenu --&gt; ClinicController : controller\n\n\n&#39; ============================================================\n&#39;              RESTRICCIONES DE DISTRIBUCIÓN\n&#39;           (NO REPRESENTAN RELACIONES DEL MODELO)\n&#39; ============================================================\n\n&#39; ===================== NIVEL SUPERIOR =====================\n\n&#39; Orden horizontal de los principales paquetes\nValidatable -[hidden]right- Person\nPerson -[hidden]right- Pet\nPet -[hidden]right- Service\n\n&#39; ===================== JERARQUÍA DE PERSONAS =====================\n\n&#39; Mantener las especializaciones debajo de Person\nPerson -[hidden]down- Employee\nEmployee -[hidden]down- Veterinarian\nEmployee -[hidden]right- Receptionist\n\n&#39; Mantener Client próximo a Person\nPerson -[hidden]left- Client\n\n&#39; Agrupar los enums de personas\nEmployeeRole -[hidden]right- ShiftType\n\n&#39; ===================== JERARQUÍA DE MASCOTAS =====================\n\n&#39; Especializaciones en el mismo nivel\nPet -[hidden]down- Dog\nDog -[hidden]right- Cat\nCat -[hidden]right- ExoticBird\n\n&#39; ===================== JERARQUÍA DE SERVICIOS =====================\n\n&#39; Especializaciones debajo de Service\nService -[hidden]down- GeneralConsultation\nGeneralConsultation -[hidden]right- Vaccination\nVaccination -[hidden]right- Surgery\n\n&#39; Enums próximos a sus clases correspondientes\nVaccineType -[hidden]right- SurgeryComplexity\n\n&#39; ===================== NÚCLEO CLÍNICO =====================\n\n&#39; Appointment como centro de las relaciones operativas\nPet -[hidden]down- Appointment\nService -[hidden]down- Appointment\n\n&#39; Distribución de las clases clínicas\nClinic -[hidden]right- Appointment\nAppointment -[hidden]right- ConsultingRoom\n\n&#39; Historial y recibo en el nivel inferior\nAppointment -[hidden]down- MedicalHistory\nAppointment -[hidden]right- Receipt\n\n&#39; Enum próximo a Appointment\nAppointment -[hidden]down- AppointmentStatus\n\n&#39; ===================== CONTROLADOR Y VISTA =====================\n\n&#39; Separar la capa de control del modelo\nClinic -[hidden]right- ClinicController\nClinicController -[hidden]right- Menu\n\n&#39; Menús debajo de la interfaz\nMenu -[hidden]down- AdminMenu\nAdminMenu -[hidden]right- ReceptionistMenu\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DSr4yh_pPKzKJuzumWf7-2163">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
