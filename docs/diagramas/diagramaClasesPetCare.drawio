<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="tMv08C2O7-6FQaozjtM8">
    <mxGraphModel dx="2058" dy="887" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml PetCare_ClassDiagram_Simple\nskinparam classAttributeIconSize 0\nskinparam packageStyle rectangle\nskinparam linetype ortho\n\npackage \&quot;org.petcare.model.person\&quot; {\n    enum EmployeeRole {\n        ADMINISTRATOR\n        RECEPTIONIST\n        VETERINARIAN\n    }\n\n    enum ShiftType {\n        MORNING\n        EVENING\n        NIGHT\n    }\n\n    abstract class Person {\n        - id: int\n        - firstName: String\n        - lastName: String\n        - phone: String\n        - email: String\n    }\n\n    class Client {\n        - address: String\n        - pets: List&lt;Pet&gt;\n        + registerPet(pet: Pet): void\n    }\n\n    abstract class Employee {\n        - employeeId: int\n        - role: EmployeeRole\n        - baseSalary: double\n    }\n\n    class Veterinarian {\n        - medicalLicense: String\n        - specialty: String\n    }\n\n    class Receptionist {\n        - assignedShift: ShiftType\n    }\n}\n\npackage \&quot;org.petcare.model.pet\&quot; {\n    abstract class Pet {\n        - id: int\n        - name: String\n        - age: int\n        - weight: double\n        + {abstract} makeSound(): void\n    }\n\n    class Dog {\n        - breed: String\n        - energyLevel: String\n        + makeSound(): void\n    }\n\n    class Cat {\n        - isDomestic: boolean\n        + makeSound(): void\n    }\n\n    class ExoticBird {\n        - wingSpan: double\n        + makeSound(): void\n    }\n}\n\npackage \&quot;org.petcare.model.service\&quot; {\n    interface Billable {\n        + calculateCost(): double\n    }\n\n    enum VaccineType {\n        RABIES\n        PARVOVIRUS\n    }\n\n    enum SurgeryComplexity {\n        LOW\n        MEDIUM\n        HIGH\n    }\n\n    abstract class Service {\n        - name: String\n        + {abstract} calculateCost(): double\n    }\n\n    class GeneralConsultation {\n        + calculateCost(): double\n    }\n\n    class Vaccination {\n        - vaccineType: VaccineType\n        + calculateCost(): double\n    }\n\n    class Surgery {\n        - hours: double\n        - complexityLevel: SurgeryComplexity\n        + calculateCost(): double\n    }\n}\n\npackage \&quot;org.petcare.model.clinic\&quot; {\n    enum AppointmentStatus {\n        SCHEDULED\n        CANCELED\n        COMPLETED\n    }\n\n    class ConsultingRoom {\n        - roomNumber: String\n    }\n\n    class MedicalHistory {\n        - appointments: TreeSet&lt;Appointment&gt;\n        + addRecord(appointment: Appointment): void\n    }\n\n    class Appointment {\n        - id: int\n        - dateTime: LocalDateTime\n        - status: AppointmentStatus\n        + setStatus(status: AppointmentStatus): void\n        + compareTo(other: Appointment): int\n    }\n\n    class Receipt {\n        - receiptNumber: int\n        - totalAmount: double\n        - issueDate: LocalDate\n        + generateTicket(): void\n    }\n\n    class Clinic {\n        - name: String\n        - address: String\n        - clients: Map&lt;Integer, Client&gt;\n        - veterinarians: Map&lt;Integer, Veterinarian&gt;\n        - rooms: Map&lt;String, ConsultingRoom&gt;\n        - appointments: List&lt;Appointment&gt;\n        + addClient(client: Client): void\n        + addVeterinarian(vet: Veterinarian): void\n        + addAppointment(appointment: Appointment): void\n    }\n}\n\npackage \&quot;org.petcare.controller\&quot; {\n    class RegistrationController {\n        + registerClient(): Client\n        + registerPet(): Pet\n        + registerVeterinarian(): Veterinarian\n    }\n\n    class AppointmentController {\n        + scheduleAppointment(): Appointment\n        + changeAppointmentStatus(): void\n        + findAppointment(): Appointment\n    }\n\n    class ClinicOperationsController {\n        + generateReceiptForAppointment(): Receipt\n        + getPetMedicalHistory(): Set&lt;Appointment&gt;\n        + removePet(): void\n    }\n}\n\npackage \&quot;org.petcare.view\&quot; {\n    interface Menu {\n        + displayOptions(): void\n    }\n\n    class AdminMenu {\n        + displayOptions(): void\n    }\n\n    class RegistrationView\n    class AppointmentView\n    class ClinicOperationsView\n}\n\n&#39; ==================== RELACIONES ====================\n\n&#39; Herencia e implementación\nPerson &lt;|-- Client\nPerson &lt;|-- Employee\nEmployee &lt;|-- Veterinarian\nEmployee &lt;|-- Receptionist\nPet &lt;|-- Dog\nPet &lt;|-- Cat\nPet &lt;|-- ExoticBird\nBillable &lt;|.. Service\nService &lt;|-- GeneralConsultation\nService &lt;|-- Vaccination\nService &lt;|-- Surgery\nMenu &lt;|.. AdminMenu\n\n&#39; Dominio\nClient \&quot;1\&quot; o-- \&quot;0..*\&quot; Pet : pets\nPet \&quot;1\&quot; *-- \&quot;1\&quot; MedicalHistory : history\nMedicalHistory \&quot;1\&quot; o-- \&quot;0..*\&quot; Appointment\nVeterinarian \&quot;0..1\&quot; --&gt; \&quot;1\&quot; ConsultingRoom\nClinic \&quot;1\&quot; *-- \&quot;1..*\&quot; ConsultingRoom\nClinic \&quot;1\&quot; o-- \&quot;0..*\&quot; Client\nClinic \&quot;1\&quot; o-- \&quot;0..*\&quot; Veterinarian\nClinic \&quot;1\&quot; o-- \&quot;0..*\&quot; Appointment\nAppointment --&gt; Pet\nAppointment --&gt; Veterinarian\nAppointment --&gt; ConsultingRoom\nAppointment \&quot;1\&quot; o-- \&quot;1..*\&quot; Service\nReceipt \&quot;1\&quot; o-- \&quot;1..*\&quot; Service\n\n&#39; Enums\nEmployee --&gt; EmployeeRole\nReceptionist --&gt; ShiftType\nVaccination --&gt; VaccineType\nSurgery --&gt; SurgeryComplexity\nAppointment --&gt; AppointmentStatus\n\n&#39; Controladores y vistas\nRegistrationController --&gt; Clinic\nAppointmentController --&gt; Clinic\nClinicOperationsController --&gt; Clinic\nClinicOperationsController ..&gt; Receipt\nAdminMenu --&gt; RegistrationView\nAdminMenu --&gt; AppointmentView\nAdminMenu --&gt; ClinicOperationsView\nRegistrationView --&gt; RegistrationController\nAppointmentView --&gt; AppointmentController\nClinicOperationsView --&gt; ClinicOperationsController\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wxFxyTbxyunIHY2QSo4r-855">
